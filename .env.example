# Vercel frontend: public HTTPS origin of the Render backend. Required on Vercel.
# Leave empty for local same-origin development.
VITE_MULTIPLAYER_URL=
# Legacy public broker is off; leave it off for deployed games.
VITE_ENABLE_PUBLIC_MQTT=false

# Render backend only. Never prefix secrets with VITE_.
# NODE_ENV=production
# SERVE_FRONTEND=false
# ROOM_CACHE_ENABLED=false
# ENABLE_PUBLIC_MQTT=false
# ALLOWED_ORIGINS=https://your-game.vercel.app,https://your-custom-domain.example
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# PORT=3000
