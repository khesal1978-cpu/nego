# Optional separate multiplayer backend. Not required to build on Vercel.
# Leave empty to use this website's /api and /ws routes.
VITE_MULTIPLAYER_URL=
# Legacy public broker is off; leave it off for deployed games.
VITE_ENABLE_PUBLIC_MQTT=false

# Vercel server secrets: connect Upstash Redis in Project > Storage.
# The Marketplace may supply KV_REST_API_URL / KV_REST_API_TOKEN instead.
# Never prefix Redis or Cloudflare secrets with VITE_.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Optional explicit namespace. Defaults isolate the project and Vercel environment.
# REDIS_NAMESPACE=sixzun:production
# Optional: additional exact frontend origins. Same-origin access works by default.
# ALLOWED_ORIGINS=https://your-custom-domain.example
# Optional TURN relay, for peers that cannot connect directly.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Local or optional standalone backend settings.
# NODE_ENV=production
# SERVE_FRONTEND=false
# ROOM_CACHE_ENABLED=false
# ENABLE_PUBLIC_MQTT=false
# PORT=3000
